PORT=3000

# Uno o varios origenes separados por coma (sin espacios extra necesarios,
# se recortan solos). Ej. tu sitio en Netlify + tu localhost para seguir
# probando en tu maquina al mismo tiempo:
# CORS_ORIGIN=https://tu-sitio.netlify.app,http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# Cadena de conexion a MongoDB (Atlas o local). Completar antes de correr la API.
MONGODB_URI=
